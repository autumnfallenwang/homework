# Template for cluster-secrets.env (gitignored). Copy to ./cluster-secrets.env
# at the repo root, fill in real values, then run:
#   bash scripts/create-cluster-secret.sh
#
# These keys must match the secretKeyRef references in deploy/chart/templates/.
# The chart never sees these values directly — they're injected via the
# homework-secrets Secret created by the script.
#
# homework needs THREE secrets: the DB URL + password, and the login-session
# signing secret. SMTP and portal passwords are user-configured through the
# Settings UI and stored in Postgres, so they are NOT cluster secrets.

# DATABASE_URL embeds POSTGRES_PASSWORD; both must use the same password so
# initdb (which consumes POSTGRES_PASSWORD) and the API (which connects via
# DATABASE_URL) agree. Host `homework-db` is the in-cluster Service DNS name.
DATABASE_URL=postgres://homework:homework@homework-db:5432/homework
POSTGRES_PASSWORD=homework

# Signs login sessions (ADR 0004). Generate once with `openssl rand -base64 32`
# and keep it: changing it signs everyone out.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
