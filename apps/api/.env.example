# PostgreSQL connection string (consumed from M02 onward)
DATABASE_URL=postgresql://homework:homework@localhost:5432/homework_dev

# HTTP server port (local dev)
API_PORT=3001

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Login sessions (ADR 0004) — required; the API refuses to start without it.
# Any long random string for local dev: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-dev-only-change-me-0123456789abcdef
# Leave COOKIE_DOMAIN unset locally (a .arch.internal cookie is dropped on localhost).
